# Tilo production env — copy to .env (never commit real secrets)
# Single contact for all regions (support, grievance, privacy/DPO, child safety, law enforcement):
# tiloappcomplaints@protonmail.com — use subject tags [SUPPORT] [PRIVACY] [GRIEVANCE] [CHILD-SAFETY] [LAW-ENFORCEMENT]
NODE_ENV=production
PORT=3000
HOST=0.0.0.0
# Public origin(s): fail-closed in production (HTTPS only). Set your real domain:
APP_ORIGIN=https://tilo.example.com
# ALLOWED_ORIGINS=https://tilo.example.com,https://www.tilo.example.com
# Proxy: enable only behind known reverse proxies (see README + Dockerfile)
# On Render/Railway/Fly the edge proxy uses dynamic private IPs: use "private"
# so X-Forwarded-For is honoured. With only 127.0.0.1 every client collapses to
# one IP and matching/rate-limits break.
TRUST_PROXY=1
TRUSTED_PROXY_IPS=private
# TRUSTED_PROXY_IPS=127.0.0.1,::1  (direct VPS + local Nginx only)
FORCE_HTTPS=true
# Video relay for mobile-carrier NAT (STUN-only fails on symmetric NAT):
# TURN_URLS=turn:turn.yourdomain.com:3478
# TURN_USERNAME=tilo
# TURN_CREDENTIAL=change-me

# --- Legal identity (must match published /legal pages) ---
COMPANY_NAME=Tilo
COMPANY_ADDRESS=India
SUPPORT_EMAIL=tiloappcomplaints@protonmail.com
GRIEVANCE_NAME=Grievance Officer — Tilo
GRIEVANCE_EMAIL=tiloappcomplaints@protonmail.com
DPO_EMAIL=tiloappcomplaints@protonmail.com
CHILD_SAFETY_EMAIL=tiloappcomplaints@protonmail.com
LAW_ENFORCEMENT_EMAIL=tiloappcomplaints@protonmail.com
CONSENT_VERSION=2026-10-06-v1

# --- Geo launch tiers (researched Oct 2026; counsel must sign each Tier) ---
# V1 deploy-ready default: India-only allow-list. Open wider only after Tier-B controls.
ALLOWED_COUNTRY_CODES=IN
# Or blocklist mode (leave ALLOWED empty to serve all except these):
BLOCKED_COUNTRY_CODES=
# CDN/proxy must send CF-IPCountry (Cloudflare) or X-Country-Code for geo gating.

# --- Retention (defaults encode CERT-In 180d + IT Rules 180d, Feb-2026 SLAs) ---
ICT_LOG_DAYS=180
SAFETY_EVIDENCE_DAYS=180
REPORT_DAYS=180
GRIEVANCE_DAYS=1095
CONSENT_DAYS=1095
BAN_HOURS_DEFAULT=24
BAN_HOURS_CHILD_SAFETY=8760

# --- Storage (pin India regions in deploy; NTP-sync hosts to NIC/NPL) ---
DATA_DIR=./data
LOG_DIR=./logs
# Stable salt for hashed IPs (generate once: openssl rand -hex 32; back up securely)
# LOG_IP_SALT=

# --- Abuse tuning ---
MAX_SOCKETS_PER_IP=8
MAX_WAITING_USERS=5000
MAX_HANDSHAKES_PER_MINUTE=30
